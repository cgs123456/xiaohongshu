# 凭据模板：复制为 .env 并填入真实值（.env 已被 .gitignore 排除，绝不入库）
MYSQL_ROOT_PASSWORD=change-me-mysql-root
REDIS_PASSWORD=change-me-redis
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=change-me-rabbitmq
MONGO_USER=root
MONGO_PASSWORD=replace-with-mongo-password
ES_PASSWORD=change-me-es
# 服务间内部调用令牌（各服务一致；不设置则内部接口禁用）
INTERNAL_TOKEN=change-me-internal-token
# JWT 密钥（建议 64 位以上随机字符串）
JWT_SECRET_KEY=replace-with-random-secret-of-64-plus-chars
DB_USERNAME=root
DB_PASSWORD=change-me-mysql-app
# 宿主机连接 MongoDB 用的完整 URI
MONGO_URI=mongodb://root:replace-with-mongo-password@localhost:27017/redbook?authSource=admin
# E2E 脚本使用的已注册测试手机号（登录收验证码用）
E2E_PHONE=change-me-test-phone
